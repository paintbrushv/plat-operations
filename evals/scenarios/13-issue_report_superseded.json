{
  "id": "issue_report_superseded",
  "title": "Issuing a report on a superseded revision is refused with SUPERSEDED and no report id is invented",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24"
      ],
      "save_revision_as": "may"
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals_corrected.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24",
        "--supersedes",
        "{rev.may}",
        "--reason",
        "Concessions credit of 400.00 was posted twice in the PMS export"
      ],
      "save_revision_as": "may2"
    }
  ],
  "question": "Issue a report on revision 1 of Sample Gardens 2026-05 and give me the report id.",
  "expect": {
    "tools": [
      {
        "function": "issue_report",
        "args_include": {
          "revision_id": "{rev.may}"
        }
      }
    ],
    "refusal": {
      "code": "SUPERSEDED"
    },
    "must_mention": [],
    "must_not_contain_numbers": false,
    "max_tokens": 1024
  }
}
