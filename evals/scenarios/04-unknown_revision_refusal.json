{
  "id": "unknown_revision_refusal",
  "title": "A revision id that does not exist is refused and the refusal is relayed",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24"
      ],
      "save_revision_as": "may"
    }
  ],
  "question": "Review revision 00000000-0000-4000-8000-000000000000 and tell me its NOI variance.",
  "expect": {
    "tools": [
      {
        "function": "review_period",
        "args_include": {
          "revision_id": "00000000-0000-4000-8000-000000000000"
        }
      }
    ],
    "refusal": {
      "code": "NOT_FOUND"
    },
    "must_mention": [],
    "must_not_contain_numbers": false,
    "max_tokens": 1024
  }
}
