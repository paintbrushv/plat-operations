{
  "id": "what_is_loaded",
  "title": "What is loaded: list the stored revisions",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24"
      ],
      "save_revision_as": "may"
    }
  ],
  "question": "What is loaded?",
  "expect": {
    "tools": [
      {
        "function": "list_revisions",
        "args_include": {}
      }
    ],
    "must_mention": [
      "result.revisions.0.unit_count"
    ],
    "must_not_contain_numbers": false,
    "max_tokens": 1024
  }
}
