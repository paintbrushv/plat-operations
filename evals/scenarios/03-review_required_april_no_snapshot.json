{
  "id": "review_required_april_no_snapshot",
  "title": "What review_required means, with April imported without a snapshot (START_HERE question 3)",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-04",
        "--units",
        "24"
      ],
      "save_revision_as": "april"
    }
  ],
  "question": "What does review_required mean here?",
  "expect": {
    "tools": [
      {
        "function": "review_period",
        "args_include": {
          "revision_id": "{rev.april}"
        }
      }
    ],
    "must_include_text": [
      "missing_occupancy_snapshot",
      [
        "not an error",
        "not a refusal",
        "not an error or a refusal",
        "numbers are still returned",
        "numbers are returned"
      ]
    ],
    "must_mention": [],
    "must_not_contain_numbers": false,
    "max_tokens": 1024
  }
}
