{
  "id": "citation_for_number",
  "title": "Asked for the citation of the NOI variance, the answer carries a trace id from an envelope",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24"
      ],
      "save_revision_as": "may"
    }
  ],
  "question": "Review Sample Gardens 2026-05, then give me the citation for the NOI variance number so I can hand it to my controller.",
  "expect": {
    "tools": [
      {
        "function": "review_period",
        "args_include": {
          "revision_id": "{rev.may}"
        }
      }
    ],
    "must_mention": [
      "result.variance.noi_bridge.noi_variance"
    ],
    "cite_traces": [
      "review_period"
    ],
    "must_not_contain_numbers": false,
    "max_tokens": 1024
  }
}
