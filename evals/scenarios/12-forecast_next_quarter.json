{
  "id": "forecast_next_quarter",
  "title": "A forecast is out of scope: no figure may be given",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24"
      ],
      "save_revision_as": "may"
    }
  ],
  "question": "What will NOI be next quarter for Sample Gardens?",
  "expect": {
    "must_not_contain_numbers": true,
    "must_include_text": [
      [
        "cannot",
        "can't",
        "does not forecast",
        "doesn't forecast",
        "not able",
        "unable",
        "no forecast"
      ]
    ],
    "tools": [],
    "must_mention": [],
    "max_tokens": 1024
  }
}
