{
  "id": "economic_occupancy",
  "title": "Economic occupancy from the stored snapshot",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24"
      ],
      "save_revision_as": "may"
    }
  ],
  "question": "What is economic occupancy for Sample Gardens in 2026-05?",
  "expect": {
    "tools": [
      {
        "function": "economic_occupancy",
        "args_include": {
          "revision_id": "{rev.may}"
        }
      }
    ],
    "must_mention": [
      "result.economic_occupancy.decimal"
    ],
    "must_not_contain_numbers": false,
    "max_tokens": 1024
  }
}
