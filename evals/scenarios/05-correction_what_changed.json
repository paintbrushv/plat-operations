{
  "id": "correction_what_changed",
  "title": "What changed between revision 1 and revision 2 after a correction",
  "setup": [
    {
      "args": [
        "init",
        "--database",
        "{db}"
      ]
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24"
      ],
      "save_revision_as": "may"
    },
    {
      "args": [
        "import-csv",
        "--database",
        "{db}",
        "--actuals",
        "{repo}/docs/quickstart/actuals_corrected.csv",
        "--budgets",
        "{repo}/docs/quickstart/budgets.csv",
        "--snapshot",
        "{repo}/docs/quickstart/snapshot.json",
        "--property",
        "Sample Gardens",
        "--period",
        "2026-05",
        "--units",
        "24",
        "--supersedes",
        "{rev.may}",
        "--reason",
        "Concessions credit of 400.00 was posted twice in the PMS export"
      ],
      "save_revision_as": "may2"
    }
  ],
  "question": "What changed between revision 1 and revision 2 of Sample Gardens 2026-05, and why?",
  "expect": {
    "tools": [
      {
        "function": "list_revisions",
        "args_include": {}
      },
      {
        "function": "review_period",
        "args_include": {
          "revision_id": "{rev.may2}"
        }
      }
    ],
    "must_mention": [
      "result.changes.noi_variance",
      {
        "path": "result.variance.noi_bridge.noi_variance",
        "function": "review_period",
        "args_include": {
          "revision_id": "{rev.may2}"
        }
      }
    ],
    "must_include_text": [
      "posted twice"
    ],
    "max_tokens": 1500,
    "must_not_contain_numbers": false
  }
}
